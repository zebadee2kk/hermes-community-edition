# Copy this file to .env and fill in your own OpenRouter API key.
# Never commit .env to GitHub.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/owl-alpha

# Optional metadata sent by some OpenRouter-compatible clients.
OPENROUTER_HTTP_REFERER=https://github.com/zebadee2kk/hermes-community-edition
OPENROUTER_APP_TITLE=Hermes Community Edition

# Optional installer behaviour.
INSTALL_HERMES_DESKTOP=false
