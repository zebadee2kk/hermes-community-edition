# Hermes Community Edition — Environment Configuration

# Model provider: ollama, lmstudio, openrouter
HERMES_MODEL_PROVIDER=ollama

# Ollama settings (for local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_PORT=11434

# OpenRouter settings (for cloud models, optional)
# OPENROUTER_API_KEY=sk-or-v1-...

# Gateway
HERMES_GATEWAY_PORT=8080
HERMES_LOG_LEVEL=INFO

# Dashboard
HERMES_DASHBOARD_PORT=3000
